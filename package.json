{
  "name": "golpo-solpo-orders",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^14.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build:eye-tracker": "esbuild components/ui/eye-tracker-client.tsx --bundle --minify --format=iife --target=es2020 --outfile=eye-tracker.bundle.js",
    "build:dancing-letters": "esbuild components/ui/dancing-letters-client.tsx --bundle --minify --format=iife --target=es2020 --outfile=dancing-letters.bundle.js",
