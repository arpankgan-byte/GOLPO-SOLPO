{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020",
      "ES2022.Intl"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "components/ui/interactive-eye-tracker.tsx",
    "components/ui/eye-tracker-client.tsx",
    "components/ui/dancing-letters.tsx",
    "components/ui/dancing-letters-client.tsx",
    "lib/utils.ts",
    "components/ui/loader-1.tsx",
    "components/ui/loader-1-client.tsx"
  ]
}
