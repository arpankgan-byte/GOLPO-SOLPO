{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/rules$",
      "dest": "/rules/"
    },
    {
      "src": "/welcome/?$",
      "dest": "/"
    },
    {
      "src": "/home/?$",
      "dest": "/"
    },
    {
      "src": "/login/?$",
      "dest": "/"
    },
    {
      "src": "/order$",
      "dest": "/order/"
    },
    {
      "src": "/panel$",
      "dest": "/panel/"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
